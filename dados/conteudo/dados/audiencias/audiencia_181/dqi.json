    },
    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Maria José Giongo",
      "trecho": "as pessoas que fumam em suas residências precisam estar cientes de que as pessoas que com ela convivem também estão sendo afetadas. Então, se há um idoso naquele ambiente, ele também está tendo a sua saúde afetada.",
      "char_start": 10228,
      "char_end": 10442,
      "fonte": "modelo",
      "rotulo": "explicito_positivo"
    },
