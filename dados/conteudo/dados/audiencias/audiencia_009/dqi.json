    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 1,
      "turno_id": 2,
      "falante": "Monize da Silva Freitas Marques",
      "trecho": "Melhor seria que tivéssemos, então, uma definição específica dessa ocupação, para que pudéssemos trazer, além da previsão da certidão negativa, outras exigências relacionadas ao próprio processo de cuidar: capacitação em áreas específicas da saúde, do trato, mediação de conflitos, a depender do que a sociedade compreender como imprescindível para essa relação, que vai além da função do trabalho doméstico, normalmente vinculado a uma assistência não pessoal de atividades profissionais.",
      "char_start": 4367,
      "char_end": 4856,
      "fonte": "modelo",
      "rotulo": "inferior"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Monize da Silva Freitas Marques",
      "trecho": "a depender do que a sociedade compreender como imprescindível para essa relação",
      "char_start": 4649,
      "char_end": 4728,
      "fonte": "modelo",
      "rotulo": "bem_comum_utilitario"
    },
    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Monize da Silva Freitas Marques",
      "trecho": "É uma honra fazer parte deste espaço destinado à proteção das pessoas vulneráveis, que acompanhamos há tanto tempo.",
      "char_start": 2183,
      "char_end": 2298,
      "fonte": "modelo",
      "rotulo": "explicito_positivo"
    },
    {
