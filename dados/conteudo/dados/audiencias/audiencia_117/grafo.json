    {
      "id": "o::0000",
      "tipo": "opiniao",
      "rotulo": "defende que a Agência Nacional de Mineração deve mudar sua metodologia de concessão por causa de crimes ambientais em Maceió e Marechal Deodoro",
      "dados": {
        "falante": "Alfredo Gaspar",
        "cargo": "",
        "turno_id": 83,
        "char_start": null,
        "char_end": null,
        "qualificadores": [
          {
            "tipo": "condicao",
            "trecho": "porque acabou uma parte de Maceió",
            "preservado": false,
            "char_start": 72865,
            "char_end": 72898
          },
          {
            "tipo": "condicao",
            "trecho": "e lá no Marechal Deodoro agora estamos com outro grande problema na mineração por conta da extração demasiada de areia, também de forma irregular",
            "preservado": false,
            "char_start": 72900,
            "char_end": 73045
          }
        ]
      }
    },
    {
      "id": "o::0001",
      "tipo": "opiniao",
      "rotulo": "questiona a omissão da ANM na proteção dos cidadãos de Maceió diante de riscos provocados pela Braskem",
      "dados": {
        "falante": "Alfredo Gaspar",
        "cargo": "",
        "turno_id": 93,
        "char_start": null,
        "char_end": null,
        "qualificadores": []
      }
    },
    {
      "id": "o::0002",
      "tipo": "opiniao",
      "rotulo": "critica a situação em que a Braskem atua como fiscal de si mesma",
      "dados": {
        "falante": "Alfredo Gaspar",
        "cargo": "",
        "turno_id": 125,
        "char_start": null,
        "char_end": null,
        "qualificadores": []
      }
    },
    {
      "id": "o::0003",
      "tipo": "opiniao",
      "rotulo": "Defende a realocação de moradores de áreas de risco em Maceió como necessária para preservar a vida, com base em estudos técnicos de 2019.",
      "dados": {
        "falante": "Alfredo Gaspar",
        "cargo": "",
        "turno_id": 208,
        "char_start": null,
        "char_end": null,
        "qualificadores": []
      }
    },
    {
      "id": "o::0004",
      "tipo": "opiniao",
      "rotulo": "defende a responsabilização penal da Braskem, seus executivos e órgãos públicos envolvidos, e exige soluções imediatas para as vítimas da mineração em Maceió",
      "dados": {
        "falante": "Alfredo Gaspar",
        "cargo": "",
        "turno_id": 351,
        "char_start": null,
        "char_end": null,
        "qualificadores": []
      }
    },
    {
      "id": "o::0005",
      "tipo": "opiniao",
      "rotulo": "defende que toda mineração exija licença ambiental, sob pena de ser considerada ilegal",
      "dados": {
        "falante": "Helder Pasti",
        "cargo": "",
        "turno_id": 86,
        "char_start": null,
        "char_end": null,
        "qualificadores": [
          {
            "tipo": "condicao",
            "trecho": "ainda que ANM tenha autorizado",
            "preservado": false,
            "char_start": 74166,
            "char_end": 74196
          }
        ]
      }
    },
    {
      "id": "o::0006",
      "tipo": "opiniao",
      "rotulo": "defende que a responsabilidade primária de monitoramento deve ser da empresa, dada a inviabilidade financeira de a agência assumi-la integralmente",
      "dados": {
        "falante": "Helder Pasti",
        "cargo": "",
        "turno_id": 143,
        "char_start": null,
        "char_end": null,
        "qualificadores": []
      }
    },
    {
      "id": "o::0007",
      "tipo": "opiniao",
      "rotulo": "defende a continuidade do monitoramento com base no princípio da precaução devido à incerteza sobre o preenchimento natural das minas",
      "dados": {
        "falante": "Leandro Galvanese Kuhlmann",
        "cargo": "pesquisador da CPRM/SGB, com graduação em Geologia pela Universidade de São Paulo e mestrado em Gestão de Desastres pelo Instituto Nacional de Pós-Graduação em Políticas Públicas de Tóquio",
        "turno_id": 6,
        "char_start": null,
        "char_end": null,
        "qualificadores": [
          {
            "tipo": "condicao",
            "trecho": "Enquanto estiver ocorrendo subsidência, enquanto estiver ocorrendo esse colapso",
            "preservado": false,
            "char_start": 21245,
            "char_end": 21324
          },
          {
            "tipo": "condicao",
            "trecho": "Como até o momento não houve comprovação da hipótese",
            "preservado": true,
            "char_start": 21730,
            "char_end": 21782
          },
          {
            "tipo": "atribuicao",
            "trecho": "o princípio da precaução sugere a continuidade do monitoramento",
            "preservado": true,
            "char_start": 21784,
            "char_end": 21847
          }
        ]
      }
    },
    {
      "id": "o::0008",
      "tipo": "opiniao",
      "rotulo": "defende a atuação do IMA ao cancelar o licenciamento de mineração após detectar subsidência e risco, negando responsabilidade por eventos anteriores",
      "dados": {
        "falante": "Ricardo César de Barros Oliveira",
        "cargo": "",
        "turno_id": 320,
        "char_start": null,
        "char_end": null,
        "qualificadores": [
          {
            "tipo": "condicao",
            "trecho": "A partir do momento que foi identificado que estava havendo subsidência e risco",
            "preservado": null,
            "char_start": 140781,
            "char_end": 140860
          }
        ]
      }
    },
    {
      "id": "o::0009",
      "tipo": "opiniao",
      "rotulo": "defende os raios de segurança estabelecidos pela CPRM como essenciais para proteger vidas, mesmo que não tenham abrangido todos os impactos",
      "dados": {
