    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Luizio Felipe Rocha",
      "trecho": "O Spotify apoia as ações para complementar a legislação concorrencial no Brasil, como uma legislação sensata que restringirá a conduta abusiva dos legítimosgatekeepersdigitais, liberará o mercado para oferecer inovação aos consumidores brasileiros e permitirá que as empresas brasileiras prosperem.",
      "char_start": 5426,
      "char_end": 5724,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
