      "char_end": 55405,
      "fonte": "modelo",
      "rotulo": "inclui"
    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 22,
      "falante": "Antonio Almerico Biondi Lima",
      "trecho": "A prática concreta não é complementar, ela é concorrente — concorrente por recurso, concorrente por espaço. Então, como na área pública só se faz o que estiver na lei, é importante delimitar o espaço na lei.",
