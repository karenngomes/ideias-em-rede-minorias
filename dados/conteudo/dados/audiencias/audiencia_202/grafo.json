    {
      "id": "o::0000",
      "tipo": "opiniao",
      "rotulo": "Defende que a regulamentação de profissões de saúde deve considerar rigor técnico-científico, segurança ao paciente e integração na equipe multidisciplinar, não apenas a existência de formação profissional.",
      "dados": {
        "falante": "Alice Portugal",
        "cargo": "Deputada",
        "turno_id": 14,
        "char_start": null,
        "char_end": null,
        "qualificadores": [
          {
            "tipo": "condicao",
            "trecho": "desde que",
            "preservado": false,
            "char_start": 40563,
            "char_end": 40572
          }
        ]
      }
    },
    {
      "id": "o::0001",
      "tipo": "opiniao",
      "rotulo": "Defende que decisões sobre regulamentação profissional em saúde devem ser baseadas em evidência técnica e científica, não em pressão ou regionalismo.",
      "dados": {
        "falante": "Alice Portugal",
        "cargo": "Deputada",
        "turno_id": 16,
        "char_start": null,
        "char_end": null,
        "qualificadores": []
      }
    },
    {
      "id": "o::0002",
      "tipo": "opiniao",
      "rotulo": "Defende a realização de nova audiência pública antes da votação do projeto, para garantir ampla discussão técnica e participação equilibrada.",
      "dados": {
        "falante": "Alice Portugal",
        "cargo": "Deputada",
        "turno_id": 28,
        "char_start": null,
        "char_end": null,
        "qualificadores": [
          {
            "tipo": "condicao",
            "trecho": "para que possamos dar oportunidade de fala a todos e todas",
            "preservado": false,
            "char_start": 55728,
            "char_end": 55786
          }
        ]
      }
    },
    {
      "id": "o::0003",
      "tipo": "opiniao",
      "rotulo": "defende a regulamentação da quiropraxia por normativa infralegal e sua inclusão em portaria da Política Nacional de Práticas Integrativas e Complementares",
      "dados": {
        "falante": "Paulo Mayall Guilayn",
        "cargo": "Coordenador de Democratização do Trabalho em Saúde, Secretaria de Gestão do Trabalho e da Educação na Saúde",
        "turno_id": 4,
        "char_start": null,
        "char_end": null,
        "qualificadores": []
      }
    },
    {
      "id": "o::0004",
      "tipo": "opiniao",
      "rotulo": "defende que não se deve aprovar lei que inclua termo sem comprovação científica, como o complexo de subluxação",
      "dados": {
        "falante": "Paulo Mayall Guilayn",
        "cargo": "Coordenador de Democratização do Trabalho em Saúde, Secretaria de Gestão do Trabalho e da Educação na Saúde",
        "turno_id": 27,
        "char_start": null,
        "char_end": null,
        "qualificadores": [
          {
            "tipo": "condicao",
            "trecho": "como esse termo está sendo usado na redação do projeto de lei",
            "preservado": false,
            "char_start": 53942,
            "char_end": 54003
          }
        ]
      }
    },
    {
      "id": "o::0005",
      "tipo": "opiniao",
      "rotulo": "é contrário à criação de novas profissões como solução para regulamentação",
      "dados": {
        "falante": "Paulo Mayall Guilayn",
        "cargo": "Coordenador de Democratização do Trabalho em Saúde, Secretaria de Gestão do Trabalho e da Educação na Saúde",
        "turno_id": 27,
        "char_start": null,
        "char_end": null,
        "qualificadores": []
      }
    },
    {
      "id": "o::0006",
      "tipo": "opiniao",
      "rotulo": "defende que a quiropraxia é uma profissão distinta e regulamentada, não uma técnica, e que seu exercício deve ser restrito a formados",
      "dados": {
        "falante": "Daniel Facchini",
        "cargo": "Presidente da Associação Brasileira de Quiropraxia",
        "turno_id": 6,
        "char_start": null,
        "char_end": null,
        "qualificadores": []
      }
    },
    {
      "id": "o::0007",
      "tipo": "opiniao",
      "rotulo": "defende a regulamentação da profissão de quiropraxia como solução para garantir segurança, qualidade e acesso",
      "dados": {
        "falante": "Daniel Facchini",
        "cargo": "Presidente da Associação Brasileira de Quiropraxia",
        "turno_id": 6,
        "char_start": null,
        "char_end": null,
        "qualificadores": []
      }
    },
    {
      "id": "o::0008",
      "tipo": "opiniao",
      "rotulo": "defende que manter a não regulamentação perpetua um estado caótico e prejudicial à saúde pública",
      "dados": {
        "falante": "Daniel Facchini",
        "cargo": "Presidente da Associação Brasileira de Quiropraxia",
        "turno_id": 17,
        "char_start": null,
        "char_end": null,
        "qualificadores": []
      }
    },
    {
      "id": "o::0009",
      "tipo": "opiniao",
      "rotulo": "defende aprofundamento do debate sobre a regulamentação da quiropraxia, com base na formação já existente em outras profissões e na segurança do paciente",
      "dados": {
        "falante": "Estevam Rivello",
        "cargo": "",
        "turno_id": 8,
        "char_start": null,
        "char_end": null,
        "qualificadores": [
          {
            "tipo": "condicao",
            "trecho": "se de fato prosseguirmos com este debate",
            "preservado": false,
            "char_start": 25437,
            "char_end": 25477
          }
        ]
      }
    },
    {
      "id": "o::0010",
      "tipo": "opiniao",
      "rotulo": "opõe-se à regulamentação de novas profissões com base em reconhecimento internacional ou abertura de cursos não regulamentados",
      "dados": {
        "falante": "Estevam Rivello",
        "cargo": "",
        "turno_id": 23,
        "char_start": null,
        "char_end": null,
        "qualificadores": [
          {
            "tipo": "condicao",
            "trecho": "quando aquilo já é praticado por profissões que estão consolidadas na assistência à população brasileira e no mundo afora",
            "preservado": false,
            "char_start": 49575,
            "char_end": 49696
          }
        ]
      }
    },
    {
      "id": "o::0011",
      "tipo": "opiniao",
      "rotulo": "opõe-se à regulamentação da quiropraxia como profissão distinta, por considerá-la recurso já incluído na fisioterapia e por basear-se em pseudociência",
      "dados": {
        "falante": "Marcelo Renato Massahud Junior",
        "cargo": "Diretor de uma universidade que tem um hospital-escola, representante do Conselho Federal de Fisioterapia",
        "turno_id": 10,
        "char_start": null,
        "char_end": null,
        "qualificadores": [
          {
            "tipo": "atribuicao",
            "trecho": "O nosso decreto-lei fala que é atividade privativa do fisioterapeuta executar métodos e técnicas fisioterápicos",
            "preservado": false,
            "char_start": 27510,
            "char_end": 27621
          },
          {
            "tipo": "atribuicao",
            "trecho": "a nossa Resolução COFFITO nº 8 diz o que são esses recursos fisioterápicos",
            "preservado": true,
            "char_start": 27724,
            "char_end": 27798
          },
          {
            "tipo": "atribuicao",
            "trecho": "a IFOMPT reconhece a osteopatia, quiropraxia, Maitland, Mulligan, McKenzie e outras técnicas manipulativas como recursos do fisioterapeuta",
            "preservado": true,
            "char_start": 28827,
            "char_end": 28965
          },
          {
            "tipo": "atribuicao",
            "trecho": "A ciência hoje em dia mostra de onde vêm os efeitos",
            "preservado": true,
            "char_start": 29431,
            "char_end": 29482
          },
          {
            "tipo": "atribuicao",
            "trecho": "Não existe nenhum trabalho que mostre que exista realmente um bloqueio no fluxo de energia vital",
            "preservado": true,
            "char_start": 30578,
            "char_end": 30674
          }
        ]
      }
    },
    {
      "id": "o::0012",
