    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 1,
      "falante": "Célia Xakriabá",
      "trecho": "Nós sabemos que, quando estamos lutando pelo território, estamos lutando pela educação também, porque não vai existir o papel, não vai existir lugar onde firmar a mão na caneta, se não existir o território. Não vai existir o papel, enquanto continuarem violentando e derrubando os corpos indígenas. Não vai existir o papel, enquanto lideranças indígenas são assassinadas, dentro e fora do território. Não vai existir possibilidade de solução para barrar a crise climática — acabamos de chegar da COP —, enquanto não se reconhecer a importância da demarcação dos territórios indígenas.",
      "char_start": 764,
      "char_end": 1348,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 3,
      "turno_id": 1,
      "falante": "Célia Xakriabá",
      "trecho": "Não vai existir possibilidade de solução para barrar a crise climática — acabamos de chegar da COP —, enquanto não se reconhecer a importância da demarcação dos territórios indígenas.",
      "char_start": 1165,
      "char_end": 1348,
      "fonte": "modelo",
      "rotulo": "bem_comum_diferenca"
    },
    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 1,
      "falante": "Célia Xakriabá",
      "trecho": "Bom dia aos parentes indígenas que são acolhidos nesta Casa neste importante dia, um dia histórico.",
      "char_start": 63,
      "char_end": 162,
      "fonte": "modelo",
      "rotulo": "explicito_positivo"
    },
    {
