    },
    {
      "dimensao": "politica_construtiva",
      "nivel": 1,
      "turno_id": 2,
      "falante": "Rosilene Cruz de Araújo",
      "trecho": "Solicitou a criação de um GT interno no Ministério da Educação para construir um relatório técnico nos próximos 60 dias, no âmbito da SESU, da SECADI, das secretarias envolvidas.",
      "char_start": 7057,
      "char_end": 7235,
      "fonte": "modelo",
      "rotulo": "proposta_alternativa"
    },
    {
      "dimensao": "respeito_contra",
      "nivel": 1,
      "turno_id": 2,
      "falante": "Rosilene Cruz de Araújo",
      "trecho": "",
      "char_start": null,
      "char_end": null,
      "fonte": "modelo",
      "rotulo": "ignora"
    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Rosilene Cruz de Araújo",
      "trecho": "Sabemos das dificuldades para chegada aos nossos territórios, então precisamos pensar em políticas céleres de formação de professores, de formação de jovens indígenas.",
      "char_start": 3898,
      "char_end": 4065,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 3,
      "turno_id": 2,
      "falante": "Rosilene Cruz de Araújo",
      "trecho": "Precisamos pensar em políticas afirmativas, para que de fato os jovens possam ter acesso à universidade.",
      "char_start": 4066,
      "char_end": 4170,
      "fonte": "modelo",
      "rotulo": "bem_comum_diferenca"
    },
    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Rosilene Cruz de Araújo",
      "trecho": "companheira dessa luta tão importante pelo fortalecimento da educação escolar indígena no contexto contemporâneo",
      "char_start": 3448,
      "char_end": 3560,
      "fonte": "modelo",
