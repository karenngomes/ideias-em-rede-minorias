    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 1,
      "falante": "Dr",
      "trecho": "Estimular e difundir a prática do esporte paralímpico em ambientes educacionais, como escolas, universidades e faculdades, por exemplo, é uma iniciativa que promove inclusão e respeito à diversidade. Desse modo, estamos abrindo portas para a quebra de estigmas e para a valorização das habilidades de todos os indivíduos, independentemente de suas habilidades físicas.",
      "char_start": 4015,
      "char_end": 4383,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 1,
      "falante": "Dr",
      "trecho": "promovendo uma sociedade mais justa e igualitária",
      "char_start": 5647,
      "char_end": 5696,
      "fonte": "modelo",
      "rotulo": "bem_comum_utilitario"
    },
    {
