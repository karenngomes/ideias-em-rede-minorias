      "dimensao": "politica_construtiva",
      "nivel": 1,
      "turno_id": 2,
      "falante": "Bruno Monteiro Portela",
      "trecho": "Nós já estamos com um decreto pronto e vamos enviá-lo para a Casa Civil, com o objetivo de criar uma espécie de comitê.",
      "char_start": 15213,
      "char_end": 15332,
