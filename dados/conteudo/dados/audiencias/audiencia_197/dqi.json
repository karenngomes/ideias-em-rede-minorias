    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Bruno Monteiro Portela",
      "trecho": "Nós não podemos deixar o espírito do marco morrer, no sentido de que ele deu muita liberdade para o gestor — muita liberdade. Mas, com a liberdade, Deputado, vem muita responsabilidade.",
      "char_start": 5376,
      "char_end": 5561,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Bruno Monteiro Portela",
      "trecho": "tratar de um tema que é muito caro para o Brasil, principalmente neste momento atual, buscando, sim, uma estratégia de país para uma agenda de futuro",
      "char_start": 2123,
      "char_end": 2272,
      "fonte": "modelo",
      "rotulo": "bem_comum_utilitario"
    },
    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Bruno Monteiro Portela",
      "trecho": "E já faço uma saudação especial a todas as pesquisadoras e todos os pesquisadores, gestores de inovação e gestores públicos que fazem parte da construção do Marco Legal de Ciência, Tecnologia e Inovação.",
