      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 23,
      "falante": "Francilene Procópio Garcia",
      "trecho": "É preciso que todos os atores do sistema trabalhem uniformemente, com a mesma compreensão do nosso marco, seja da lei, seja do decreto.",
      "char_start": 93969,
      "char_end": 94104,
      "fonte": "modelo",
      "rotulo": "bem_comum_utilitario"
    },
