    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 4,
      "falante": "Rosane Silva",
      "trecho": "Sabemos que, para a sustentabilidade da vida humana, o cuidado é algo determinante na nossa vida. Em algum momento da nossa vida, todos nós precisamos de cuidado. Aliás, para estarmos aqui neste momento, debatendo esse tema, alguém está fazendo a tarefa de cuidado, seja nas nossas casas, seja no nosso cotidiano. Alguém acabou de nos servir água aqui e está nos servindo café. Isso é política de cuidado.",
      "char_start": 11987,
      "char_end": 12392,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 4,
      "falante": "Rosane Silva",
      "trecho": "para que essa seja uma pauta do conjunto da sociedade brasileira e não somente uma pauta das mulheres ou de quem está produzindo essa política no interior do Governo.",
      "char_start": 16667,
      "char_end": 16833,
      "fonte": "modelo",
      "rotulo": "bem_comum_utilitario"
    },
    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 4,
      "falante": "Rosane Silva",
      "trecho": "este tema tão importante para nós, mulheres, e para a sociedade brasileira.",
      "char_start": 10679,
      "char_end": 10754,
      "fonte": "modelo",
      "rotulo": "explicito_positivo"
    },
