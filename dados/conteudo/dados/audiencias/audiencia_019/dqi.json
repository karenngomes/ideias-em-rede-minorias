    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 1,
      "falante": "Juninho do Pneu",
      "trecho": "A segurança viária, em especial a dos usuários vulneráveis, como os pedestres e ciclistas, deve ser prioridade nas ações públicas.",
      "char_start": 2262,
      "char_end": 2392,
      "fonte": "modelo",
      "rotulo": "explicito_positivo"
    },
    {
      "dimensao": "respeito_demandas",
