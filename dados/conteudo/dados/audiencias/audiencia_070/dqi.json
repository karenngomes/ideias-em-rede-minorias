    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 2,
      "falante": "John Fernando de Farias Würdig",
      "trecho": "O IBAMA concedeu o licenciamento — compete ao IBAMA a concessão de licenciamento para esse tipo de empreendimento —, no dia 18 de fevereiro deste ano. Concedeu licença à UTE Rio de Janeiro, composta por quatro térmicas flutuantes, uma unidade de gás e as 36 torres de linhas de transmissão. Isso foi o que o IBAMA concedeu.",
      "char_start": 8104,
      "char_end": 8427,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 2,
      "falante": "John Fernando de Farias Würdig",
      "trecho": "Nós não podemos abrir precedente para que isso se multiplique pelo Brasil, devaste a nossa legislação e passe, então, a boiada dessas térmicas flutuantes por todo o nosso litoral brasileiro.",
      "char_start": 16700,
      "char_end": 16890,
      "fonte": "modelo",
      "rotulo": "bem_comum_utilitario"
    },
    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 2,
      "falante": "John Fernando de Farias Würdig",
      "trecho": "os pescadores e as marisqueiras dessa baía",
      "char_start": 10148,
      "char_end": 10190,
      "fonte": "modelo",
      "rotulo": "explicito_positivo"
    },
    {
