    {
      "dimensao": "politica_construtiva",
      "nivel": 1,
      "turno_id": 7,
      "falante": "Helena de Godoy Bergallo",
      "trecho": "A primeira solução é parar essa instalação de termelétricas, fazer valer a legislação ambiental.",
