      "fonte": "modelo",
      "rotulo": "neutro"
    },
    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 4,
      "falante": "Elias Vaz",
      "trecho": "o IDEC tem sido um importante parceiro em nossas audiências públicas, sempre contribuindo bastante, até mesmo do ponto de vista técnico. É uma discussão do direito consumidor muito bem embasada",
      "char_start": 29495,
      "char_end": 29688,
      "fonte": "modelo",
      "rotulo": "explicito_positivo"
    },
    {
      "dimensao": "respeito_demandas",
      "nivel": 1,
      "turno_id": 4,
      "falante": "Elias Vaz",
      "trecho": "",
      "char_start": null,
      "char_end": null,
      "fonte": "modelo",
      "rotulo": "neutro"
    },
    {
      "dimensao": "politica_construtiva",
      "nivel": 1,
      "turno_id": 5,
      "falante": "Marcos Bicalho dos Santos",
      "trecho": "nós entendemos que, por ser um serviço público essencial, esse benefício, que hoje é dirigido à pesca e também à navegação de cabotagem, possa ser também estendido ao transporte público coletivo, por ser um serviço público de natureza essencial.",
      "char_start": 41728,
      "char_end": 41973,
      "fonte": "modelo",
      "rotulo": "proposta_alternativa"
    },
    {
      "dimensao": "respeito_contra",
      "nivel": 1,
      "turno_id": 5,
      "falante": "Marcos Bicalho dos Santos",
      "trecho": "",
      "char_start": null,
      "char_end": null,
      "fonte": "modelo",
      "rotulo": "ignora"
    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 5,
      "falante": "Marcos Bicalho dos Santos",
      "trecho": "Na medida em que nós temos uma queda de demanda desta ordem que foi verificada e a oferta não cai na mesma proporção, existe um diferencial entre o custo e a receita do sistema que se acumulou ao longo desse período e trouxe graves consequências para o setor.",
      "char_start": 32316,
      "char_end": 32575,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 5,
      "falante": "Marcos Bicalho dos Santos",
      "trecho": "Eu gostaria de agradecer a oportunidade e o convite desta Comissão de Viação e Transportes para participar desta audiência pública, que trata de um assunto de suma importância tanto para a população, como para as empresas operadoras e a sociedade em geral.",
      "char_start": 30158,
      "char_end": 30414,
      "fonte": "modelo",
      "rotulo": "bem_comum_utilitario"
    },
    {
