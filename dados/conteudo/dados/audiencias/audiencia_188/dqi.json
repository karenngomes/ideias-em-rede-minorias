    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Mercedes Bustamante",
      "trecho": "Isso já nos coloca, talvez, a demanda de políticas públicas que abordem essa situação.",
      "char_start": 11836,
      "char_end": 11922,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 3,
      "turno_id": 2,
      "falante": "Mercedes Bustamante",
      "trecho": "combater a injustiça socioeconômica colocada aqui, mas também a étnico-racial, que se revela e se reflete nessa elevada desigualdade",
      "char_start": 17335,
      "char_end": 17467,
      "fonte": "modelo",
      "rotulo": "bem_comum_diferenca"
    },
    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Mercedes Bustamante",
      "trecho": "combater a injustiça socioeconômica colocada aqui, mas também a étnico-racial, que se revela e se reflete nessa elevada desigualdade; investir na construção pedagógica de instrumentos de gênero para as áreas do conhecimento onde nós temos menor participação das mulheres, com infraestrutura também nas escolas públicas; desmistificar também que algumas carreiras têm recortes mais masculinos e outras, mais femininos; implementar políticas e mecanismos também contra a misoginia, o racismo e a xenofobia em todos os espaços de aprendizado e da produção científica, combatendo os estereótipos, os obstáculos à prorrogação e à promoção no âmbito da carreira, a distribuição desigual do trabalho não remunerado e dos cuidados domésticos, que é um aspecto social mais amplo e importante, o assédio sexual, que é um dos aspectos também que afasta muito as mulheres da carreira, e outras violências de gênero, os casos de desigualdade salarial e também a sub-representação da multiplicidade do gênero, da raça e da etnia.",
      "char_start": 17335,
      "char_end": 18350,
      "fonte": "modelo",
      "rotulo": "explicito_positivo"
    },
