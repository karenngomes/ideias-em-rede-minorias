    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 20,
      "falante": "Alexandre Pinheiro dos Santos",
      "trecho": "O princípio a que me refiro aqui é o princípio dofull and fair disclosure, o princípio da transparência, o princípio da informação completa, precisa, consistente, para que o investidor ou a investidora do outro lado, como juiz competente por seus investimentos, como bem aponta a literatura especializada aqui e ao redor do mundo, possa ter condições, em simetria com qualquer outra ou outro, de decidir se aporta os seus recursos para aquele empreendimento; se retira os recursos no momento em que entender que é o caso; se se desfaz daquilo — ele adquire, vende, desfaz-se ou mantém.",
      "char_start": 66573,
      "char_end": 67158,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
