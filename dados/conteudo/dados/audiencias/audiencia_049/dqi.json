    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Daniela Reinehr",
      "trecho": "E essa foi a razão pela qual eu convoquei esta audiência pública, para que nós possamos discutir esse tema de vital importância para o desenvolvimento e para a segurança também do Estado de Santa Catarina e de todos os que passam por aquela região, que todos sabem que é uma região turística, uma região que liga a Capital catarinense ao Sul do Brasil, em uma rota extremamente importante que envolve essa questão dos dois túneis no Morro dos Cavalos, na BR-101.",
      "char_start": 7706,
      "char_end": 8168,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Daniela Reinehr",
      "trecho": "para que nós possamos discutir esse tema de vital importância para o desenvolvimento e para a segurança também do Estado de Santa Catarina e de todos os que passam por aquela região",
      "char_start": 7772,
      "char_end": 7953,
      "fonte": "modelo",
      "rotulo": "bem_comum_utilitario"
    },
    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Daniela Reinehr",
      "trecho": "a toda a população brasileira, especialmente à população de Santa Catarina, que tem se mobilizado para ajudar de todas as formas o povo gaúcho.",
      "char_start": 6216,
      "char_end": 6359,
      "fonte": "modelo",
      "rotulo": "explicito_positivo"
    },
    {
