    {
      "dimensao": "respeito_contra",
      "nivel": 2,
      "turno_id": 4,
      "falante": "Cristiano Nabuco",
      "trecho": "Quando falamos isto, principalmente com os repórteres, eles dizem assim:\"Espera um pouquinho, Dr. Cristiano! Isso é uma questão de controle. A tecnologia está aí, como sempre esteve. Sobrevivemos à televisão, ao telefone, ao jornal. Então, desculpe, não queira demonizar aqui a tecnologia!\". E eu mostro esta fotografia aqui para esses repórteres",
      "char_start": 13661,
      "char_end": 14007,
      "fonte": "modelo",
      "rotulo": "inclui"
    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 4,
      "falante": "Cristiano Nabuco",
      "trecho": "Isso está fazendo, então, com que essas pessoas se tornem cada vez mais dependentes, ou seja, quanto mais utilizamos, mais dependentes nos tornamos.",
      "char_start": 14682,
      "char_end": 14830,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 4,
      "falante": "Cristiano Nabuco",
      "trecho": "Ou nós nos movimentamos rapidamente ou nós vamos entrar em um estado de calamidade pública jamais visto!",
      "char_start": 15165,
      "char_end": 15269,
      "fonte": "modelo",
      "rotulo": "bem_comum_utilitario"
    },
