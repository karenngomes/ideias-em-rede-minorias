    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 9,
      "falante": "Aline Paz",
      "trecho": "Nós percebemos que as ruas eram muito mais cheias de crianças brincando, interagindo. Nesse contato social há uma troca, nessa troca há uma socialização, nessa socialização a criança aprende a lidar com negociações, com limites, com estratégias de negociação. Então, perdemos muito quando essa tecnologia, que veio para nutrir as relações humanas e como forma de otimizar o tempo e até mesmo aproximar distâncias, em alguns aspectos tem mais afastado pessoas próximas, como percebemos, do que aproximado.",
      "char_start": 22160,
      "char_end": 22664,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 9,
      "falante": "Aline Paz",
      "trecho": "para que possamos, então, preservar a saúde das nossas crianças.",
      "char_start": 25180,
      "char_end": 25244,
      "fonte": "modelo",
      "rotulo": "bem_comum_utilitario"
    },
    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 9,
      "falante": "Aline Paz",
      "trecho": "É importante que nós tenhamos a consciência de que o ser humano tem essa necessidade intrínseca de se relacionar, de se sentir pertencente.",
      "char_start": 23263,
      "char_end": 23402,
      "fonte": "modelo",
      "rotulo": "explicito_positivo"
    },
