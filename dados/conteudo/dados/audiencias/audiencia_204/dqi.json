    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 5,
      "falante": "Meire Serafim",
      "trecho": "Pedimos muito respeito pelas imagens que estamos trazendo. Todas foram autorizadas, mas temos que ter bastante respeito pelos pacientes que estão contribuindo conosco.",
