    {
      "id": "o::0000",
      "tipo": "opiniao",
      "rotulo": "Defende que países desenvolvidos devem pagar por danos ambientais históricos e ajudar na preservação de florestas em países como o Brasil.",
      "dados": {
        "falante": "Zé Silva",
        "cargo": "Deputado e presidente da Comissão de Legislação Participativa",
        "turno_id": 1,
        "char_start": null,
        "char_end": null,
        "qualificadores": [
          {
            "tipo": "atribuicao",
            "trecho": "Nós temos 62% das nossas florestas nativas ainda intactas, e eles precisam nos ajudar a preservá-las. É o que eu falei da produção e da conservação.",
            "preservado": false,
            "char_start": 3481,
            "char_end": 3629
          }
        ]
      }
    },
    {
