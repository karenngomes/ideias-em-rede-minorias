    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Fernando Peregrino",
      "trecho": "O Brasil não pode perder esses investimentos, porque já foram feitos muitos. Foram quase 20 bilhões de reais ao longo dessa série histórica. O País não pode quebrar contratos. Eu não vejo como se quebram contratos num país desse! Não se quebra um sem ameaçar os outros! Isso trará, certamente, insegurança jurídica aos investidores.",
      "char_start": 8527,
      "char_end": 8859,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Fernando Peregrino",
      "trecho": "O Brasil não pode perder esses investimentos, porque já foram feitos muitos. Foram quase 20 bilhões de reais ao longo dessa série histórica. O País não pode quebrar contratos. Eu não vejo como se quebram contratos num país desse! Não se quebra um sem ameaçar os outros! Isso trará, certamente, insegurança jurídica aos investidores.",
      "char_start": 8527,
