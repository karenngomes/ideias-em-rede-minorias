      "fonte": "modelo",
      "rotulo": "bem_comum_utilitario"
    },
    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Adriana Almeida",
      "trecho": "Nós sabemos que todas as candidaturas, em todas as eleições, passam por um processo de disputas que, às vezes, é acirrado, mas essas disputas devem ser baseadas em ideias e propostas.",
