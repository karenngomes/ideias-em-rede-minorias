      "dimensao": "politica_construtiva",
      "nivel": 1,
      "turno_id": 23,
      "falante": "Prof. Reginaldo Veras",
      "trecho": "Fizemos uma emenda à PEC que diz, em relação ao acúmulo de um cargo de professor com outro cargo de qualquer natureza, que é o que nós estamos debatendo aqui, que será também possível que o professor atue como microempreendedor individual, nos termos da Lei Complementar nº 128, de dezembro de 2018.",
      "char_start": 61949,
      "char_end": 62248,
      "fonte": "modelo",
