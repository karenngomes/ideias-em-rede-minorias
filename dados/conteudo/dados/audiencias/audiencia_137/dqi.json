    {
      "dimensao": "respeito_grupos",
      "nivel": 2,
      "turno_id": 11,
      "falante": "Prof. Paulo Fernando",
      "trecho": "Há professores que trabalham em duas escolas públicas; há professores que trabalham numa instituição privada e numa pública; há colegas professores que trabalham em duas instituições privadas; alguns, em escolas comunitárias; outros, em escolas confessionais; outros, ainda, em escolas particulares.",
