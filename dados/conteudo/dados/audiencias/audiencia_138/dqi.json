    {
      "dimensao": "justificacao_nivel",
      "nivel": 1,
      "turno_id": 14,
      "falante": "Waldemar Gonçalves Ortunho Júnior",
      "trecho": "o nosso primeiro problema é cultural, é saber quais são nossos direitos em termos de proteção de dados.",
      "char_start": 21566,
      "char_end": 21669,
      "fonte": "modelo",
      "rotulo": "inferior"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 14,
      "falante": "Waldemar Gonçalves Ortunho Júnior",
      "trecho": "O cidadão fornece seus dados para a empresa A, B ou C. Se ofereceram desconto, ele está lançando os seus dados. Quando existe um vazamento, a parte mais difícil é saber de qual das empresas houve esse vazamento, tendo em vista que só ele sabe para quem forneceu os dados, e foi para uma infinidade de empresas.",
      "char_start": 21671,
      "char_end": 21981,
      "fonte": "modelo",
      "rotulo": "bem_comum_utilitario"
    },
