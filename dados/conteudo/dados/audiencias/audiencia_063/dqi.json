    {
      "dimensao": "politica_construtiva",
      "nivel": 1,
      "turno_id": 2,
      "falante": "Karla Giacomin",
      "trecho": "Portanto, Deputado, é urgente criar um cadastro nacional com dados oficiais, municipais, regionais e nacionais sobre as instituições de longa permanência, sobre a população assistida, sobre os recursos, tanto humanos quanto financeiros, disponíveis.",
      "char_start": 8700,
      "char_end": 8949,
      "fonte": "modelo",
      "rotulo": "proposta_alternativa"
    },
    {
