    },
    {
      "dimensao": "justificacao_nivel",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Karla Giacomin",
      "trecho": "É preciso enfrentar o idadismo, o preconceito contra a idade; construir cidades amigáveis para as pessoas em envelhecimento; promover cuidados integrados entre a saúde e a assistência social e garantir cuidados de longa duração.",
      "char_start": 2740,
      "char_end": 2968,
      "fonte": "modelo",
      "rotulo": "qualificada"
    },
    {
      "dimensao": "justificacao_conteudo",
      "nivel": 2,
      "turno_id": 2,
      "falante": "Karla Giacomin",
      "trecho": "Essa questão é de todos nós, pois diz respeito a como devem ser tratadas as pessoas que precisam de cuidados cuja família não pode cuidar, não consegue cuidar ou não existe.",
